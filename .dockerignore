*.db-wal

# Environment files
.env
.env.local
.env.production
.env.*.local

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Project-specific
fly-deployment
fly.toml.local