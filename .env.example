# Bu faylni .env ga nusxalang yoki o'zgaruvchilarni to'g'ridan-to'g'ri export qiling.
# Muhit o'zgaruvchilari config.json dagi qiymatlarni bekor qiladi (server.js ga qarang).
# Real secretlarni hech qachon git ga commit qilmang.

# Server qaysi portda ishlaydi (Fly.io buni avtomatik beradi)
PORT=3001

# Admin panel login/paroli (production da MAJBURIY)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuchli-parol-qoying

# HWID xeshlash uchun secret (production da MAJBURIY, kamida 32 tasodifiy belgi)
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=64-belgili-tasodifiy-hex-satr-qoying

# SQLite baza yo'li (standart: ./licenses.db, Fly.io da: /data/licenses.db)
DB_PATH=./licenses.db

# Node muhiti
NODE_ENV=development
