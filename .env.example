# Copy this file to .env or export these variables directly.
# Environment variables override values in config.json (see server.js).
# NEVER commit real secrets to git.

# Port the server listens on (Fly.io sets this automatically)
PORT=3001

# Admin panel credentials (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used for HWID hashing (REQUIRED in production, min 32 random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# SQLite database path (default: ./licenses.db, on Fly.io: /data/licenses.db)
DB_PATH=./licenses.db

# Node environment
NODE_ENV=development
